rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// These rules are the real lock on the data. Keep the two lists below in
// sync with config.js (lowercase emails).

service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmails() {
      return [
        'admin@yourcompany.com'
      ];
    }

    function memberEmails() {
      return [
        'employee@yourcompany.com'
      ];
    }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in adminEmails(); }
    function isMember() { return signedIn() && (isAdmin() || email() in memberEmails()); }

    function ticket(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
    }
    function ownerOf(ticketId) {
      return ticket(ticketId).createdBy.uid;
    }

    match /tickets/{ticketId} {
      // Admins see everything; members only see their own requests.
      allow read: if isAdmin()
                  || (isMember() && resource.data.createdBy.uid == request.auth.uid);

      // Members create requests as themselves, always starting as "open".
      allow create: if isMember()
                    && request.resource.data.createdBy.uid == request.auth.uid
                    && request.resource.data.createdBy.email == email()
                    && request.resource.data.status == 'open'
                    && request.resource.data.type is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    // New employee requests are admin-only.
                    && (request.resource.data.type != 'new_employee' || isAdmin());

      // Admins change status. The requester may only add attachments (and record the email result) on their own request.
      allow update: if (isAdmin()
                        && request.resource.data.createdBy == resource.data.createdBy)
                    || (isMember()
                        && resource.data.createdBy.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments', 'emailStatus', 'updatedAt'])
                        && (!('attachments' in request.resource.data) || request.resource.data.attachments.size() <= 40));

      // Admins can delete any request; employees can delete their own once it's completed.
      allow delete: if isAdmin()
                    || (isMember()
                        && resource.data.createdBy.uid == request.auth.uid
                        && resource.data.status == 'completed');

      // Attachment data, split into pieces under 1 MB each.
      match /chunks/{chunkId} {
        allow read:   if isAdmin() || (isMember() && ownerOf(ticketId) == request.auth.uid);
        allow create: if (isAdmin() || (isMember() && ownerOf(ticketId) == request.auth.uid))
                      && request.resource.data.keys().hasOnly(['data'])
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 800000;
        allow delete: if isAdmin()
                      || (isMember()
                          && ticket(ticketId).createdBy.uid == request.auth.uid
                          && ticket(ticketId).status == 'completed');
      }
    }

    // Client Pipeline: written only by the Workable sync (service account bypasses
    // these rules); anyone on the access list can read it.
    match /workable_clients/{clientId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /workable_meta/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Each person's own dashboard preferences (like their column layout).
    match /user_prefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
