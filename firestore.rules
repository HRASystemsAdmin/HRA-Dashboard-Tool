rules_version = '2';

// RULES VERSION: 2026-11-18 (Training, admin clean-up tools, profile photos)
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// These rules are the real lock on the data. Keep the two lists below in
// sync with config.js (lowercase emails).

service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmails() {
      return [
        'jrochin@hunterrecruitment.net',
        'kcooney@hunterrecruitment.net'
      ];
    }

    function memberEmails() {
      // Add employees here, one per line, in single quotes, separated by commas.
      return [
        'jomohundro@hunterrecruitment.net'
      ];
    }

    // Managers who can see everyone's training progress (admins always can).
    // Keep in sync with training.js → trainers. Trainers must also be in memberEmails().
    function trainerEmails() {
      return [
      ];
    }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in adminEmails(); }
    function isMember() { return signedIn() && (isAdmin() || email() in memberEmails()); }
    function isTrainer() { return isAdmin() || (isMember() && email() in trainerEmails()); }

    function ticket(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
    }
    function ownerOf(ticketId) {
      return ticket(ticketId).createdBy.uid;
    }

    match /tickets/{ticketId} {
      // Admins see everything; members only see their own requests.
      allow read: if isAdmin()
                  || (isMember() && resource.data.createdBy.uid == request.auth.uid);

      // Members create requests as themselves, always starting as "open".
      allow create: if isMember()
                    && request.resource.data.createdBy.uid == request.auth.uid
                    && request.resource.data.createdBy.email == email()
                    && request.resource.data.status == 'open'
                    && request.resource.data.type is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    // New employee requests are admin-only.
                    && (request.resource.data.type != 'new_employee' || isAdmin());

      // Admins change status. The requester may only add attachments (and record the email result) on their own request.
      allow update: if (isAdmin()
                        && request.resource.data.createdBy == resource.data.createdBy)
                    || (isMember()
                        && resource.data.createdBy.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments', 'emailStatus', 'updatedAt'])
                        && (!('attachments' in request.resource.data) || request.resource.data.attachments.size() <= 40));

      // Admins can delete any request; employees can delete their own once it's completed.
      allow delete: if isAdmin()
                    || (isMember()
                        && resource.data.createdBy.uid == request.auth.uid
                        && resource.data.status == 'completed');

      // Attachment data, split into pieces under 1 MB each.
      match /chunks/{chunkId} {
        allow read:   if isAdmin() || (isMember() && ownerOf(ticketId) == request.auth.uid);
        allow create: if (isAdmin() || (isMember() && ownerOf(ticketId) == request.auth.uid))
                      && request.resource.data.keys().hasOnly(['data'])
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 800000;
        allow delete: if isAdmin()
                      || (isMember()
                          && ticket(ticketId).createdBy.uid == request.auth.uid
                          && ticket(ticketId).status == 'completed');
      }
    }

    // Client Pipeline: written only by the Workable sync (service account bypasses
    // these rules); anyone on the access list can read it.
    match /workable_clients/{clientId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /workable_meta/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // All-employees alert: everyone on the access list sees it; only admins can post or end it.
    match /broadcast/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // History of past alerts, for the notification center.
    match /broadcast_log/{alertId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Each person's own dashboard preferences (like their column layout).
    match /user_prefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Profiles: name and a small photo. Everyone on the team can see them; people edit only their own.
    match /profiles/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'email', 'updatedAt'])
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 150000))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
    }

    // Training: people save their own progress; admins and trainers can see everyone's.
    match /training_progress/{uid} {
      allow read: if isMember() && (request.auth.uid == uid || isTrainer());
      allow write: if isMember() && request.auth.uid == uid;
      allow delete: if isAdmin();               // admins can reset anyone's progress
    }
    // Personal notes on training steps: private to each person (managers can't read them).
    match /training_private/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
      allow delete: if isAdmin();               // admins can delete notes, but never read them
    }
    // Questions from trainees and notes from managers.
    match /training_notes/{noteId} {
      allow read: if isMember() && (resource.data.traineeUid == request.auth.uid || isTrainer());
      allow create: if isMember() && (request.resource.data.traineeUid == request.auth.uid || isTrainer());
      allow update: if isMember() && (resource.data.traineeUid == request.auth.uid || isTrainer());
      allow delete: if isTrainer();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
